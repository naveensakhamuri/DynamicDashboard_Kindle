<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antigravity.kindle-dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Replace with path to your python3 binary (e.g. /opt/homebrew/bin/python3 or /usr/bin/python3) -->
        <string>/usr/bin/python3</string>
        <string>-u</string>
        <!-- Replace with absolute path to your dashboard/server.py -->
        <string>/ABSOLUTE/PATH/TO/DynamicDashboard_Kindle/dashboard/server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/DynamicDashboard_Kindle/dashboard</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/DynamicDashboard_Kindle/dashboard/server.log</string>

    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/DynamicDashboard_Kindle/dashboard/server.err</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
